{
 "title": "SagaFlow",
 "uid": "sagaflow",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Saga starts / completions (per min)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(sagaflow_saga_started_total[1m]))*60 or vector(0)",
     "refId": "A",
     "legendFormat": "{{__name__}}"
    }
   ]
  },
  {
